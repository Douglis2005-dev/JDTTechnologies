<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JDTTechnologies</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/JDTTechnologies.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="header" id="header">
        <a href="#inicio" class="header-logo" aria-label="JDT TECHNOLOGICS - Inicio">
            <span class="header-logo-text">
                <img alt="Logo" height="30px" width="30px"
                     src="data:image/png;base64,">
                <span class="header-logo-sub">TECHNOLOGICS</span>
            </span>
        </a>
        <nav class="header-nav" aria-label="Navegación principal">
            <ul class="header-menu">
                <li><a href="#que-hacemos">Qué hacemos</a></li>
                <li><a href="#desarrollo-web">Web</a></li>
                <li><a href="#desarrollo-movil">Móvil</a></li>
                <li><a href="#automatizaciones">Automatizaciones</a></li>
                <li><a href="#como-trabajamos">Proceso</a></li>
                <li><a href="#contacto" class="cta-nav">Contacto</a></li>
            </ul>
        </nav>
        <button class="menu-toggle" id="menuToggle" aria-label="Abrir menú" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>